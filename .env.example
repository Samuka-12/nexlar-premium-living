# Supabase server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Iron Pay — mantenha estas variáveis somente no ambiente do servidor
IRONPAY_BASE_URL=https://api.ironpayapp.com.br/api/public/v1
IRONPAY_API_TOKEN=
IRONPAY_OFFER_HASH=
IRONPAY_PRODUCT_HASH=
IRONPAY_WEBHOOK_TOKEN=

# URL pública HTTPS que a Iron Pay chamará após mudanças de status
IRONPAY_POSTBACK_URL=https://seu-dominio.com/api/webhooks/ironpay
# Alternativa usada somente se IRONPAY_POSTBACK_URL não for definida
APP_BASE_URL=https://seu-dominio.com
